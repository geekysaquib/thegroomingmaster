PORT=4000
CLIENT_URL=http://localhost:5173

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: server only, never expose to the frontend
SUPABASE_SERVICE_KEY=

JWT_SECRET=change-me-to-a-long-random-string

# SMTP for e-bills (e.g. Gmail app password, Resend/SendGrid SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Grooming Master <no-reply@example.com>"

# Used by `npm run seed:admin`
ADMIN_EMAIL=admin@groomingmaster.com
ADMIN_PASSWORD=ChangeMe123!
